// secrets.h is gitignored — never commit real credentials.
#pragma once

#define WIFI_SSID     "your_wifi_ssid"
#define WIFI_PASSWORD "your_wifi_password"

#define MQTT_BROKER   "110.0.4.169"   // Home Assistant IP or hostname
#define MQTT_PORT     1883
#define MQTT_USER     "irrigation"
#define MQTT_PASSWORD "your_mqtt_password"

// Unique for every controller connected to the same MQTT broker.
// Use only lowercase letters, numbers, "_" and "-"; maximum 32 characters.
// Must match an id in homeassistant/instances.yaml (e.g. raised_bed, vegetable_garden).
#define IRRIGATION_INSTANCE_ID   "raised_bed"
#define IRRIGATION_INSTANCE_NAME "Raised Bed"
